<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/storage_holder"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:animateLayoutChanges="true"
    tools:ignore="HardcodedText">

    <RelativeLayout
        android:id="@+id/free_space_holder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/activity_margin"
        android:paddingEnd="@dimen/activity_margin"
        app:layout_constraintTop_toTopOf="parent">

        <org.fossify.commons.views.MyTextView
            android:id="@+id/storage_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/expand_button"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/internal"
            android:textSize="@dimen/big_text_size" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/free_space_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/storage_name"
            android:text="…"
            android:textSize="@dimen/storage_free_space_text_size"
            tools:text="23 GB" />

        <ImageView
            android:id="@+id/expand_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:padding="@dimen/medium_margin"
            android:src="@drawable/ic_arrow_up_vector" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/free_space_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/total_space"
            android:layout_alignBaseline="@+id/free_space_value"
            android:layout_alignBottom="@+id/free_space_value"
            android:layout_marginStart="@dimen/medium_margin"
            android:layout_toEndOf="@+id/free_space_value"
            android:text="@string/storage_free"
            android:textSize="@dimen/big_text_size"
            android:visibility="invisible" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/main_storage_usage_progressbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/free_space_value"
            android:layout_marginTop="@dimen/medium_margin"
            android:layout_marginBottom="@dimen/medium_margin"
            android:max="100"
            app:trackThickness="4dp" />

        <org.fossify.commons.views.MyTextView
            android:id="@+id/total_space"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/main_storage_usage_progressbar"
            android:layout_marginBottom="@dimen/big_margin"
            android:textSize="@dimen/big_text_size"
            tools:text="Total storage: 64 GB" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/categories_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/normal_margin"
        android:paddingTop="@dimen/normal_margin"
        android:paddingEnd="@dimen/normal_margin"
        android:paddingBottom="@dimen/normal_margin"
        app:layout_constraintTop_toBottomOf="@+id/free_space_holder">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/images_holder"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tile_height"
                android:layout_weight="1"
                android:layout_margin="@dimen/category_tile_margin"
                android:background="@drawable/bg_category_tile"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/images_icon"
                    android:layout_width="@dimen/category_tile_icon_size"
                    android:layout_height="@dimen/category_tile_icon_size"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:src="@drawable/ic_category_images_vector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/images_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="2dp"
                    android:text="@string/images"
                    android:textSize="@dimen/normal_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/images_size"
                    app:layout_constraintStart_toStartOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/images_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="@dimen/normal_margin"
                    android:alpha="0.7"
                    android:text="…"
                    android:textSize="@dimen/small_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="20 GB" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/videos_holder"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tile_height"
                android:layout_weight="1"
                android:layout_margin="@dimen/category_tile_margin"
                android:background="@drawable/bg_category_tile"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/videos_icon"
                    android:layout_width="@dimen/category_tile_icon_size"
                    android:layout_height="@dimen/category_tile_icon_size"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:src="@drawable/ic_category_videos_vector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/videos_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="2dp"
                    android:text="@string/videos"
                    android:textSize="@dimen/normal_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/videos_size"
                    app:layout_constraintStart_toStartOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/videos_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="@dimen/normal_margin"
                    android:alpha="0.7"
                    android:text="…"
                    android:textSize="@dimen/small_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="20 GB" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/audio_holder"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tile_height"
                android:layout_weight="1"
                android:layout_margin="@dimen/category_tile_margin"
                android:background="@drawable/bg_category_tile"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/audio_icon"
                    android:layout_width="@dimen/category_tile_icon_size"
                    android:layout_height="@dimen/category_tile_icon_size"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:src="@drawable/ic_category_audio_vector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/audio_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="2dp"
                    android:text="@string/audio"
                    android:textSize="@dimen/normal_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/audio_size"
                    app:layout_constraintStart_toStartOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/audio_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="@dimen/normal_margin"
                    android:alpha="0.7"
                    android:text="…"
                    android:textSize="@dimen/small_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="20 GB" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/documents_holder"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tile_height"
                android:layout_weight="1"
                android:layout_margin="@dimen/category_tile_margin"
                android:background="@drawable/bg_category_tile"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/documents_icon"
                    android:layout_width="@dimen/category_tile_icon_size"
                    android:layout_height="@dimen/category_tile_icon_size"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:src="@drawable/ic_category_documents_vector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/documents_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="2dp"
                    android:text="@string/documents"
                    android:textSize="@dimen/normal_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/documents_size"
                    app:layout_constraintStart_toStartOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/documents_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="@dimen/normal_margin"
                    android:alpha="0.7"
                    android:text="…"
                    android:textSize="@dimen/small_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="20 GB" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/archives_holder"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tile_height"
                android:layout_weight="1"
                android:layout_margin="@dimen/category_tile_margin"
                android:background="@drawable/bg_category_tile"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/archives_icon"
                    android:layout_width="@dimen/category_tile_icon_size"
                    android:layout_height="@dimen/category_tile_icon_size"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:src="@drawable/ic_category_archives_vector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/archives_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="2dp"
                    android:text="@string/archives"
                    android:textSize="@dimen/normal_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/archives_size"
                    app:layout_constraintStart_toStartOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/archives_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="@dimen/normal_margin"
                    android:alpha="0.7"
                    android:text="…"
                    android:textSize="@dimen/small_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="20 GB" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/others_holder"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_tile_height"
                android:layout_weight="1"
                android:layout_margin="@dimen/category_tile_margin"
                android:background="@drawable/bg_category_tile"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:id="@+id/others_icon"
                    android:layout_width="@dimen/category_tile_icon_size"
                    android:layout_height="@dimen/category_tile_icon_size"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginTop="@dimen/normal_margin"
                    android:src="@drawable/ic_category_others_vector"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/others_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="2dp"
                    android:text="@string/others"
                    android:textSize="@dimen/normal_text_size"
                    app:layout_constraintBottom_toTopOf="@+id/others_size"
                    app:layout_constraintStart_toStartOf="parent" />

                <org.fossify.commons.views.MyTextView
                    android:id="@+id/others_size"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:layout_marginBottom="@dimen/normal_margin"
                    android:alpha="0.7"
                    android:text="…"
                    android:textSize="@dimen/small_text_size"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    tools:text="20 GB" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
